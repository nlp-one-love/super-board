{
  "swagger": "2.0",
  "info": {
    "description": "Subset of Gitea 28.2.0 swagger.v1.json: Projects and dependencies. Source: https://git.pzemlyanoy.ru/swagger.v1.json",
    "title": "Gitea API",
    "license": {
      "name": "MIT",
